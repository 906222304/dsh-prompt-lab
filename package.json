{
  "name": "dsh-prompt-lab",
  "version": "0.6.4",
  "description": "提示词（Prompt Lab）：DeepSeek Harness 的 AI 提示词创作与共享规则管理面板，支持生成、改写、提取规则和注入诊断",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./ui": "./lib/ui.js",
    "./client": "./client.js",
    "./ai": "./lib/ai.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "references/README.zh-CN.md",
    "references/dsh-client-slots.md",
    "CHANGELOG.md",
    "docs/host-contract.md",
    "docs/release-0.5.1.md",
    "docs/release-0.5.2.md",
    "docs/release-0.5.3.md",
    "docs/release-0.5.4.md",
    "docs/settings-guide.zh-CN.md",
    "docs/ai-studio.zh-CN.md",
    "docs/release-0.6.0.md",
    "docs/release-0.6.2.md",
    "docs/release-0.6.3.md",
    "docs/project-workflows.zh-CN.md",
    "docs/release-0.6.4.md",
    "docs/assets-guide.zh-CN.md",
    "docs/runtime-acceptance-0.6.3.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt-lab",
    "提示词",
    "系统提示词"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:plain": "node tests/plugin.test.mjs && node tests/stability.test.mjs && node tests/client.test.mjs && node tests/management.test.mjs && node tests/studio.test.mjs && node tests/studio-foundations.test.mjs && node tests/experiments.test.mjs && node tests/project-diagnostics.test.mjs && node tests/regression-source.test.mjs && node tests/session-bindings.test.mjs && node tests/scenarios.test.mjs && node tests/asset-journal.test.mjs && node tests/asset-package.test.mjs",
    "test:host": "node scripts/host-smoke.cjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "test:rollback": "node scripts/rollback-smoke.cjs",
    "test:package": "node scripts/package-smoke.cjs",
    "extract:purge-prompt": "node scripts/extract-dsh-purge-prompt.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
